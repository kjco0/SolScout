# Example systemd unit. Adjust paths/user, then:
#   sudo cp deploy/solscout.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now solscout
[Unit]
Description=SolScout Solana new-token alerts
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=solscout
WorkingDirectory=/opt/solscout
EnvironmentFile=/opt/solscout/.env
ExecStart=/opt/solscout/.venv/bin/python -m solscout
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
