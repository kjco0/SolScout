# Telegram: create a bot with @BotFather, then get your chat id from @userinfobot
# (for a group, add the bot and use the negative group id).
TELEGRAM_TOKEN=
CHAT_ID=

# Set to 1 to print alerts to stdout instead of sending them.
DRY_RUN=0

# Filters
MAX_AGE_MINUTES=60        # only tokens whose first pair is younger than this
MIN_VOLUME_H1=100000      # USD traded in the last hour on the token's busiest pair
MIN_LIQUIDITY_USD=0       # pump.fun bonding-curve tokens report no liquidity; 0 keeps them
MIN_BUY_RATIO=0           # buys / (buys + sells) in the last hour, 0..1

POLL_SECONDS=60
DB_PATH=solscout.db
LOG_LEVEL=INFO
